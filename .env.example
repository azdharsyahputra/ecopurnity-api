HTTP_ADDR=:8080
POSTGRES_PRIMARY_URL=postgres://ecopurnity:ecopurnity@localhost:5432/ecopurnity?sslmode=disable
POSTGRES_REPLICA_URL=postgres://ecopurnity:ecopurnity@localhost:5433/ecopurnity?sslmode=disable
REPLICA_MAX_LAG_SECONDS=5
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=ecopurnity
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
APP_URL=http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
GOOGLE_DEV_LOGIN=true

# Server secret for one-time-code HMACs (>= 32 chars). Generate: openssl rand -hex 32
APP_SECRET=
# SMTP (leave SMTP_HOST empty to log emails instead). Local catcher: make up starts Mailpit (UI http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Ecopurnity <no-reply@ecopurnity.local>"
# SMTP_TLS=starttls   # tls (465) | starttls (587) | none (local only); defaults from the port

# Object storage, S3-compatible. Local: SeaweedFS from docker-compose (S3 API on :8333; the API creates the dev bucket).
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto, S3_PATH_STYLE=false,
# bucket + an R2 API token (Object Read & Write) as the key pair. The bucket needs a CORS rule allowing PUT/GET from
# APP_URL (see README).
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=ecopurnity-dev
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
S3_PATH_STYLE=true
S3_CREATE_BUCKET=true
# Browser origins allowed to PUT/GET presigned URLs (applied to the bucket at startup when the credentials allow it).
S3_CORS_ORIGINS=http://localhost:5173,http://localhost:5180
